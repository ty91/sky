class Sky < Formula
  desc "Slack chatbot with per-thread Pi AgentSession conversations"
  homepage "https://github.com/ty91/sky"
  url "__URL__"
  sha256 "__SHA256__"
  version "__VERSION__"
  license "MIT"

  depends_on "node@24"
  depends_on arch: :arm64
  depends_on :macos

  def install
    ENV.prepend_path "PATH", Formula["node@24"].opt_bin
    system "npm", "install", *std_npm_args, "--omit=dev", "--ignore-scripts"

    # Homebrew ad-hoc re-signs every Mach-O it installs, and that corrupts the
    # darwin-universal clipboard slice. napi loads that slice before darwin-arm64,
    # and loading the corrupted one gets the whole process SIGKILLed, so keep only
    # the arm64 prebuilds.
    Dir.glob("#{libexec}/lib/node_modules/@ty91/sky/node_modules/**/*.node").each do |addon|
      rm addon unless addon.include?("darwin-arm64")
    end

    # `sky` and `skyd` are a deployment contract: an installed LaunchAgent plist
    # records #{HOMEBREW_PREFIX}/bin/skyd in ProgramArguments and must stay valid
    # across upgrades. node@24 is keg-only, so both wrappers put it on PATH.
    (bin/"sky").write_env_script libexec/"bin/sky", PATH: "#{Formula["node@24"].opt_bin}:$PATH"
    (bin/"skyd").write_env_script libexec/"bin/skyd", PATH: "#{Formula["node@24"].opt_bin}:$PATH"
  end

  def caveats
    <<~CAVEATS
      Sky owns its launchd agent; Homebrew only ships the files. Set it up with:

        sky service install
        sky slack manifest --open
        sky init

      `brew upgrade sky` replaces files but leaves the running daemon on the old
      code, and the old files are deleted, so restart after every upgrade:

        sky restart

      `sky doctor` reports runtime.control as FAIL while that drift is present.
    CAVEATS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sky --version")
    assert_match version.to_s, shell_output("#{bin}/skyd --version")
    # Both bins must exist and skyd must refuse to daemonize implicitly.
    assert_match "must be run explicitly with --foreground", shell_output("#{bin}/skyd", 1)
  end
end
