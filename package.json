{
  "name": "sky",
  "version": "0.1.0",
  "description": "Slack chatbot with per-thread Pi AgentSession conversations",
  "type": "module",
  "private": true,
  "bin": {
    "sky": "dist/index.js",
    "sky-restart-harness-mcp": "dist/mcp/restart-harness-server.js"
  },
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
    "restart": "node dist/index.js restart",
    "status": "node dist/index.js status",
    "run": "node dist/index.js run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@anthropic-ai/sdk": "^0.110.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/bolt": "^4.6.0",
    "commander": "^14.0.3",
    "undici": "^7.24.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
