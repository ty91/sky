{
  "name": "joy",
  "version": "0.1.0",
  "description": "Telegram chatbot with per-chat Claude Agent SDK sessions",
  "type": "module",
  "private": true,
  "bin": {
    "joy": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/bot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
    "restart": "node dist/index.js restart",
    "status": "node dist/index.js status",
    "run": "node dist/index.js run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@grammyjs/runner": "^2.0.3",
    "@slack/bolt": "^4.6.0",
    "commander": "^14.0.3",
    "grammy": "^1.41.1",
    "undici": "^7.24.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
