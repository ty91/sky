{
  "name": "@ty91/sky",
  "version": "0.1.0",
  "description": "Slack chatbot with per-thread Pi AgentSession conversations",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "sky": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/bot.ts",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
    "restart": "node dist/index.js restart",
    "status": "node dist/index.js status",
    "run": "node dist/index.js run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:package": "node --test test/package-release.smoke.mjs",
    "release:check-tag": "node scripts/verify-release-tag.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ty91/sky.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.219",
    "@anthropic-ai/sdk": "0.110.0",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.3",
    "commander": "14.0.3",
    "cron-parser": "5.7.0",
    "undici": "7.24.5",
    "zod": "4.3.6"
  }
}
